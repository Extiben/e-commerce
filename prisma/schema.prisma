// V01D — Modelo de datos
// En desarrollo usamos SQLite. Para producción cambia provider a "postgresql"
// y DATABASE_URL a tu base Postgres (Neon, Supabase, Railway...).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  details     String      @default("")
  category    String // hoodies | camisetas | pantalones | chaquetas | accesorios
  price       Int // en pesos COP (sin centavos)
  compareAt   Int?
  images      String      @default("[]") // JSON: string[]
  tag         String?
  featured    Boolean     @default(false)
  active      Boolean     @default(true)
  sortOrder   Int         @default(0)
  variants    Variant[]
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Variant {
  id        String      @id @default(cuid())
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  color     String
  colorHex  String      @default("#111111")
  size      String
  stock     Int         @default(0)
  sku       String      @unique
  items     OrderItem[]

  @@unique([productId, color, size])
}

model Order {
  id            String      @id @default(cuid())
  reference     String      @unique
  status        String      @default("PENDING") // PENDING | PAID | DECLINED | VOIDED | ERROR | SHIPPED | DELIVERED | CANCELLED
  email         String
  fullName      String
  phone         String
  legalIdType   String      @default("CC")
  legalId       String
  address       String
  address2      String      @default("")
  city          String
  region        String
  notes         String      @default("")
  subtotal      Int
  shipping      Int
  discount      Int         @default(0)
  discountCode  String?
  total         Int
  paymentMethod String?
  wompiTxId     String?
  trackingCode  String?
  stockApplied  Boolean     @default(false)
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId String?
  name      String
  color     String
  size      String
  image     String   @default("")
  price     Int
  quantity  Int
}

model DiscountCode {
  id        String   @id @default(cuid())
  code      String   @unique
  percent   Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
