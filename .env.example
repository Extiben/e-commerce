# ─── Base de datos ───────────────────────────────────────────
# Desarrollo (SQLite local). En producción usa Postgres:
# DATABASE_URL="postgresql://user:pass@host:5432/v01d"
DATABASE_URL="file:./dev.db"

# ─── URL pública de la tienda (sin / final) ─────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Panel de administración ────────────────────────────────
ADMIN_PASSWORD="cambia-esta-clave"
# Cadena aleatoria larga (ej: openssl rand -hex 32)
SESSION_SECRET="cambia-esto-por-una-cadena-aleatoria-larga"

# ─── Wompi (https://comercios.wompi.co → Desarrolladores) ───
# Si las dejas vacías, la tienda funciona en MODO DEMO con un pago simulado.
# Sandbox: pub_test_ / prv_test_ / test_integrity_ / test_events_
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""

# ─── Subidas de imágenes del panel ──────────────────────────
UPLOAD_DIR="./uploads"
